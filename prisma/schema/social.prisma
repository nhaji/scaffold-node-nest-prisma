// Social Module
// Models: Comment

// Comments
model Comment {
  id          Int      @id @default(autoincrement())
  text        String   @db.Text
  timestamp   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  // AUDIT FIELDS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById Int?
  createdBy   User? @relation("CommentCreatedByUser", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("CommentUpdatedByUser", fields: [updatedById], references: [id])

  @@map("comments")
}
